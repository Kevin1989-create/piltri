# --- Supabase ---
# The public dataset bucket is read at build time (scripts/sync-dataset.mjs);
# the service role key is used server-side for Resources links and by the
# data pipeline when publishing. Never expose the service role key client-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Password for the /admin back-office page (dataset status, Resources links).
ADMIN_PASSWORD=
