# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Cache control ---
# Number of days a cached city score is considered fresh before re-aggregating
CACHE_TTL_DAYS=30

# --- Scheduled cache warming (see HANDOFF.md "Scheduled cache warming") ---
# Verifies Vercel Cron's own request to /api/cron/warm-cache-tick — Vercel
# sends this same value in an Authorization: Bearer header automatically
# once CRON_SECRET is set here and in Vercel's env vars. Generate any long
# random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=
# Shared password for the /admin back-office page (city coverage status,
# manual "warm now" trigger). Anyone with this can trigger warm-cache and
# view coverage stats — not sensitive data, but pick a real password anyway.
ADMIN_PASSWORD=
