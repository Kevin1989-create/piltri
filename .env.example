# --- Supabase ---
# The public dataset bucket is read at build time (scripts/sync-dataset.mjs);
# the secret key (sb_secret_..., Project Settings -> API Keys) is used
# server-side for Resources links and by the data pipeline when publishing.
# Never expose it client-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Accounts (2026-11-08): the public "anon" key (Project Settings -> API
# Keys) - meant to be public; row-level security (supabase/saved-items.sql)
# is what protects each person's saved places. Without it the site works
# as before, saving in the browser only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin ---
# Password for the /admin back-office page (dataset status, Resources links).
ADMIN_PASSWORD=
